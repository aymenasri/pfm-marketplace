<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- On hérite des configurations de Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- Identifiant de ton projet global -->
    <groupId>com.pfm</groupId>
    <artifactId>pfm-marketplace</artifactId>
    <version>1.0-SNAPSHOT</version>
    
    <!-- TRÈS IMPORTANT : packaging doit être "pom" pour un projet parent -->
    <packaging>pom</packaging>

    <name>pfm-marketplace</name>
    <description>Projet de fin de module - Marketplace microservices</description>

    <properties>
        <!-- Mets ici la même version de Java que tu as choisie dans l'assistant (17 ou 21) -->
        <java.version>21</java.version>
    </properties>

    <!-- La liste des modules du projet -->
    <modules>
        <module>eureka-server</module>
        <module>api-gateway</module>
        <module>service-catalogue</module>
        <module>service-commande</module>
        <module>service-stock</module>
    </modules>

</project>